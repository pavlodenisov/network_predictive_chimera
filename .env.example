# Chimera Network Intelligence — environment template.
# Copy to `.env` (never commit `.env`). All secrets are read from the environment (§39).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: local SQLite file (no server needed). Absolute or relative path.
DATABASE_URL=sqlite+pysqlite:///./chimera.db
# Production example (requires `pip install -e '.[postgres]'`):
# DATABASE_URL=postgresql+psycopg://chimera:chimera@localhost:5432/chimera

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
CHIMERA_API_HOST=127.0.0.1
CHIMERA_API_PORT=8000
# Comma-separated origins allowed to call the API (the Next.js dev server).
CHIMERA_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM extraction (OPTIONAL). Leave unset for the fully-deterministic V0 pipeline.
# When set, the ClaudeExtractor activates behind the same Extractor interface (§22-23).
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
CHIMERA_EXTRACTOR=rules            # rules | claude   (claude requires ANTHROPIC_API_KEY)
CHIMERA_CLAUDE_MODEL=claude-sonnet-5
CHIMERA_EXTRACTION_PROMPT_VERSION=extract_v0.1

# ---------------------------------------------------------------------------
# Pipeline / run metadata
# ---------------------------------------------------------------------------
CHIMERA_CODE_VERSION=dev
CHIMERA_CONFIG_DIR=./configs
CHIMERA_LOG_LEVEL=INFO
CHIMERA_LOG_FORMAT=console         # console | json

# ---------------------------------------------------------------------------
# Live news fetching (OPTIONAL). Off by default — RSS adapter reads db/seeds/news/*.xml.
# ---------------------------------------------------------------------------
CHIMERA_RSS_LIVE=0

# ---------------------------------------------------------------------------
# Web search (OPTIONAL). WebSearchSource no-ops (status=disabled) without this —
# no scraping, ever. Get a key at https://tavily.com (generous free tier).
# ---------------------------------------------------------------------------
# TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (apps/web/.env.local reads this)
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
